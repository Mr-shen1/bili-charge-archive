# M0 local development examples only. Replace values before any non-local deployment.
MYSQL_DATABASE=bili_charge_archive
MYSQL_USER=bili_dev
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
APP_PORT=18080
WEB_PORT=18081

# M1 requires these three values. For local Compose, place a private file at deploy/.env.
# Use a BCrypt hash of your chosen password and a random token of at least 32 characters.
ADMIN_USERNAME=replace-with-admin-name
ADMIN_PASSWORD_BCRYPT=replace-with-bcrypt-hash
MONITOR_API_TOKEN=replace-with-at-least-32-random-characters

# Later milestones will supply these only through a protected runtime configuration.
BILI_COOKIE=replace-with-bili-cookie
FEISHU_WEBHOOK_ENC_KEY=replace-with-encryption-key
FEISHU_APP_ID=replace-with-app-id
FEISHU_APP_SECRET=replace-with-app-secret
OSS_REGION=replace-with-region
OSS_BUCKET=replace-with-private-bucket
OSS_ACCESS_KEY_ID=replace-with-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret
